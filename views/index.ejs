<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Search App</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background: linear-gradient(to right, #141e30, #243b55);
            color: white;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
        }

        .container-box{
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            margin-top: 40px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .movie-card{
            background: rgba(255,255,255,0.12);
            border: none;
            border-radius: 15px;
            transition: 0.3s;
        }

        .movie-card:hover{
            transform: scale(1.03);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .btn-custom{
            background: #ff416c;
            border: none;
        }

        .btn-custom:hover{
            background: #ff4b2b;
        }

        .title{
            font-size: 3rem;
            font-weight: bold;
            text-align: center;
            margin-bottom: 30px;
        }

        .search-box{
            margin-bottom: 25px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="container-box">

        <h1 class="title">🎬 Movie Search App</h1>

        <!-- Add Movie Form -->
        <form action="/add" method="POST" class="row g-3 mb-4">

            <div class="col-md-3">
                <input type="text" name="title" class="form-control" placeholder="Movie Title" required>
            </div>

            <div class="col-md-2">
                <input type="number" name="year" class="form-control" placeholder="Year">
            </div>

            <div class="col-md-3">
                <input type="text" name="genre" class="form-control" placeholder="Genre">
            </div>

            <div class="col-md-2">
                <input type="number" step="0.1" name="rating" class="form-control" placeholder="Rating">
            </div>

            <div class="col-md-2">
                <button class="btn btn-custom text-white w-100">
                    Add Movie
                </button>
            </div>

        </form>

        <!-- Search Form -->
        <form action="/search" method="GET" class="search-box d-flex gap-2">

            <input 
                type="text" 
                name="q" 
                class="form-control"
                placeholder="Search movies..."
            >

            <button class="btn btn-warning">
                Search
            </button>

        </form>

        <!-- Movie Cards -->
        <div class="row">

            <% movies.forEach(movie => { %>

                <div class="col-md-4 mb-4">

                    <div class="card movie-card text-white p-3 h-100">

                        <h3>🎥 <%= movie.title %></h3>

                        <p><strong>Year:</strong> <%= movie.year %></p>

                        <p><strong>Genre:</strong> <%= movie.genre %></p>

                        <p><strong>Rating:</strong> ⭐ <%= movie.rating %></p>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>
</div>

</body>
</html>